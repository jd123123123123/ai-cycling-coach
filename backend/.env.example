DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:5433/cycling_coach
JWT_SECRET_KEY=change-me-in-production
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret
CORS_ORIGINS=http://localhost:5173
DEBUG=true
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_ENCRYPTION_KEY=<generate with python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# AI Coach — Claude is PRIMARY. Unset → every surface falls back to rule-based.
# ANTHROPIC_API_KEY=sk-ant-...
# OpenAI is the FALLBACK provider, tried ONLY when a Claude call fails on a
# credit/quota/billing/auth/rate/5xx error. Mirrors the Anthropic key above —
# leave both unset for pure rule-based operation. Default model: gpt-4o-mini.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
